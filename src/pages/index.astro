---
const pageTitle = "Home";
const description =
  "Professional web developer specialising in academic, scientific, EU-funded Horizon Europe projects, plus UKRI and national research projects.";
import { Image, Picture } from "astro:assets";
import myImage from "../assets/banner-large.webp";
import whatsApp from "../assets/whatsapp-button.svg";
import mugShot from "../assets/me2.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Schema } from "astro-seo-schema";
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <Schema
    item={{
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Martin Cook Design",
      description:
        "Website of Martin Cook, a web developer who makes websites for science, academia, Horizon Europe and EU-funded projects.",
      url: "https://martincookdesign.co.uk",
      image: "https://martincookdesign.co.uk/images/logo.svg",
      keywords:
        "developer, copyeditor, website, science, academia, Horizon Europe, European Union",
    }}
  />
  <div class="full-width banner">
    <Picture
      src={myImage}
      formats={["avif", "webp"]}
      alt=""
      layout="constrained"
      priority
    />
    <div class="banner-text">
      <div>Website development for research and academia</div>
    </div>
  </div>

  <p class="text-x-large">
    <strong
      >I make and maintain websites for science, academia and EU-funded
      projects. I handle the planning, coding, copyediting and compliance, so
      you can focus on the bigger tasks.
    </strong>
  </p>

  <p>
    I've spent 25 years making websites in academia and have built or run sites
    like the Institute of Historical Research, ELIXIR Europe, King's College,
    Cambridge, Genomic Data Infrastructure and the Global Biodata Coalition. I
    have an MSc in Neuroscience and have sat on the editorial boards of
    community resources like RDMkit.
  </p>

  <h2>One person for the whole project</h2>
  <ul>
    <li>
      <strong>Grant applications:</strong> I'll help you choose the simplest technical
      solution and give you a realistic cost to put in your proposal.
    </li>
    <li>
      <strong>Planning:</strong> I work with you and your stakeholders to plan the
      content of the site. We can also discuss using UX exercises to improve the usability
      of the site, and where you would like to use AI (if at all).
    </li>
    <li>
      <strong>Design and build:</strong> I design to your brand, or create one, and
      build with a technology that suits your needs.
    </li>
    <li>
      <strong>Content:</strong> I write and edit copy from your grant documents and
      papers, and collect content from partners so you don't have to chase them. I'm
      a native English speaker and speak upper intermediate (B2) French.
    </li>
    <li>
      <strong>Compliance:</strong> sites are accessible (WCAG) and GDPR-compliant
      from the start. I hold the W3C certificate in digital accessibility.
    </li>
    <li>
      <strong>Maintenance and archiving:</strong> I keep the site up to date during
      the project, and make sure it stays available or is properly archived when the
      funding ends.
    </li>
  </ul>
  <h2>How it works</h2>

  <section class="process-cards">
    <div class="step-line">
      <div class="step-num">1</div>
      <h3>Chat</h3>
      <p>We discuss your project, timeline and outputs.</p>
    </div>

    <div class="step-line">
      <div class="step-num">2</div>
      <h3>Quote</h3>
      <p>A fixed price or an estimate for ongoing work.</p>
    </div>

    <div class="step-line">
      <div class="step-num">3</div>
      <h3>Build</h3>
      <p>Design, content and review cycles.</p>
    </div>

    <div class="step-line">
      <div class="step-num">4</div>
      <h3>Launch</h3>
      <p>Go live and handover.</p>
    </div>

    <div class="step-line">
      <div class="step-num">5</div>
      <h3>Maintain</h3>
      <p>Updates, development and archiving.</p>
    </div>
  </section>
  <div class="tinted float-container full-width">
    <div class="container">
      <figure class="float-right">
        <Image
          src={mugShot}
          alt="A photo of me"
          layout="constrained"
          width={225}
          loading="lazy"
        />
      </figure>
      <h2 class="contact">Get in touch</h2>
      <p>
        I'm always interested in people's web projects! Tell me what you're
        planning and we'll discuss ideas or a quote. I'm based just outside
        Cambridge, so if you're nearby or passing through, we can meet in
        person.
      </p>
      <div class="text-primary text-xx-large mt-0 mb-1">07455 624491</div>
      <div class="mb-3">
        <a href="mailto:martin@martincookdesign.co.uk"
          >martin@martincookdesign.co.uk</a
        >
      </div>
      <div>
        <a aria-label="Chat on WhatsApp" href="https://wa.me/7455624491">
          <Image
            src={whatsApp}
            alt="WhatsApp button"
            layout="constrained"
            width={190}
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>

  <h2>Find out more</h2>
  <ul>
    <li>
      See the <a href="/about/">About page</a> for my portfolio and background.
    </li>
    <li>
      See the <a href="/how-help/">How I can help</a> page for what I can do, and&nbsp;
      <a href="/how-much-costs/">How much it costs</a> for prices.
    </li>
  </ul>
</BaseLayout>
