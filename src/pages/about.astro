  <script>
    const scroller = document.querySelector<HTMLElement>(".scroller");
    const prevBtn = document.getElementById(
      "prevBtn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "nextBtn",
    ) as HTMLButtonElement | null;
    const dotsContainer = document.getElementById("dots");

    if (scroller && prevBtn && nextBtn && dotsContainer) {
      initCarousel(scroller, prevBtn, nextBtn, dotsContainer);
    }

    function initCarousel(
      scroller: HTMLElement,
      prevBtn: HTMLButtonElement,
      nextBtn: HTMLButtonElement,
      dotsContainer: HTMLElement,
    ) {
      const sections = [...scroller.querySelectorAll<HTMLElement>("section")];
      const dots: HTMLButtonElement[] = [];
      let current = 0;

      // ARIA setup
      scroller.setAttribute("role", "region");
      scroller.setAttribute("aria-roledescription", "carousel");
      scroller.setAttribute("aria-label", "Examples of web development");
      scroller.setAttribute("tabindex", "0");

      sections.forEach((sec, i) => {
        sec.setAttribute("role", "group");
        sec.setAttribute("aria-roledescription", "slide");
        sec.setAttribute("aria-label", `${i + 1} of ${sections.length}`);
        sec.setAttribute("aria-hidden", i === 0 ? "false" : "true");
      });

      // Build dots
      sections.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.className = "carousel-dot" + (i === 0 ? " active" : "");
        dot.setAttribute(
          "aria-label",
          `Go to slide ${i + 1} of ${sections.length}`,
        );
        dot.addEventListener("click", () => goTo(i));
        dotsContainer.appendChild(dot);
        dots.push(dot);
      });

      function goTo(index: number) {
        sections[current].classList.remove("active");
        sections[current].setAttribute("aria-hidden", "true");
        dots[current].classList.remove("active");

        current = index;

        sections[current].classList.add("active");
        sections[current].setAttribute("aria-hidden", "false");
        dots[current].classList.add("active");

        prevBtn.disabled = current === 0;
        nextBtn.disabled = current === sections.length - 1;
        dots[current].setAttribute("aria-current", "true");
        dots.forEach((d, i) => {
          if (i !== current) d.removeAttribute("aria-current");
        });
      }

      prevBtn.addEventListener("click", () => current > 0 && goTo(current - 1));
      nextBtn.addEventListener(
        "click",
        () => current < sections.length - 1 && goTo(current + 1),
      );

      // Keyboard support
      scroller.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" && current < sections.length - 1) {
          e.preventDefault();
          goTo(current + 1);
        } else if (e.key === "ArrowLeft" && current > 0) {
          e.preventDefault();
          goTo(current - 1);
        }
      });

      // Swipe support
      let touchStartX = 0;

      scroller.addEventListener(
        "touchstart",
        (e) => {
          touchStartX = e.touches[0].clientX;
        },
        { passive: true },
      );

      scroller.addEventListener(
        "touchend",
        (e) => {
          const diff = touchStartX - e.changedTouches[0].clientX;
          const threshold = 50; // minimum px swipe distance to count

          if (Math.abs(diff) < threshold) return;

          if (diff > 0 && current < sections.length - 1) {
            goTo(current + 1); // swiped left → next
          } else if (diff < 0 && current > 0) {
            goTo(current - 1); // swiped right → prev
          }
        },
        { passive: true },
      );

      prevBtn.disabled = true;
    }
  </script>
